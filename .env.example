# ==============================================================================
# VARIÁVEIS DE AMBIENTE - PORTAL DE DESPACHO INTELIGENTE TÁXI 2.0
# ==============================================================================

# BANCO DE DADOS (PostgreSQL - Supabase)
# Pooler Connection (Porta 6543)
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (Porta 5432 - usada para migrations do Prisma)
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# INTEGRAÇÃO API TÁXI DIGITAL (APITD v3)
TAXI_DIGITAL_BASE_URL="https://api.taxidigital.net/APITD/"
TAXI_DIGITAL_USER="seu_usuario_taxidigital"
TAXI_DIGITAL_PASS="sua_senha_taxidigital"
TAXI_DIGITAL_UI_CLIENTE="CLIENTE_CORPORATIVO_PADRAO"

# INTELIGÊNCIA ARTIFICIAL MULTIMODAL (Google Gemini Pro / Flash)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""

# AUTENTICAÇÃO REAL & SESSÃO (JWT HttpOnly Cookies)
# Chave secreta de 32+ caracteres para assinar os tokens JWT da sessão (ex: openssl rand -hex 32)
AUTH_SECRET="chave_secreta_minimo_32_caracteres_aleatorios_para_jwt_taxi20"

# SEED INICIAL DO PRIMEIRO GESTOR (Executado via `npm run prisma:seed` ou npx tsx prisma/seed.ts)
# Não deixe senhas fixas no código; a senha deve ter no mínimo 8 caracteres
SEED_GESTOR_LOGIN="gestor"
SEED_GESTOR_SENHA="senhaSeguraGestor2025#"

# PORTAL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
